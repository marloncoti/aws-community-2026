---
import { getImage } from 'astro:assets';
import heroBackground from '../assets/brand/hero-background.png';
import eventLogo from '../assets/brand/logo-awscd-2026.png';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'AWS Community Day Guatemala 2026',
	description = 'AWS Community Day Guatemala 2026: patrocinadores, organizadores y todo lo que necesitas saber del evento de la comunidad AWS en Guatemala.',
} = Astro.props;

const ogImage = await getImage({ src: heroBackground, width: 1200, height: 630, format: 'jpg' });
const logoImage = await getImage({ src: eventLogo, width: 192, height: 115, format: 'png' });
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage.src, Astro.site);
const logoURL = new URL(logoImage.src, Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#14101c" />

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />
		<meta name="language" content="es" />
		<meta name="author" content="AWS Community Day Guatemala" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="AWS Community Day Guatemala" />
		<meta property="og:locale" content="es_GT" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Organization',
			name: 'AWS Community Day Guatemala',
			url: 'https://awscommunitygt.com',
			logo: logoURL.toString(),
			sameAs: [],
		})} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-ink: #232f3e;
		--color-ink-soft: #2e3f52;
		--color-orange: #ff9900;
		--color-orange-dark: #e07c00;
		--color-violet: #6d4aad;
		--color-violet-deep: #2a1f3d;
		--color-near-black: #14101c;
		--color-magenta: #e5327a;
		--gradient-accent: linear-gradient(90deg, var(--color-magenta), var(--color-orange));
		--color-bg: #faf9f7;
		--color-surface: #ffffff;
		--color-border: #e4e1da;
		--color-text: #1a2230;
		--color-text-muted: #5c6b7a;
		--color-text-inverse: #f5f7fa;
		--color-text-inverse-muted: #aeb9c4;

		--font-display: 'Space Grotesk', 'Arial Narrow', sans-serif;
		--font-body: 'IBM Plex Sans', system-ui, sans-serif;

		--container-width: 1180px;
		--section-padding-block: 4rem;
		--edge-pad: 1.25rem;
		--edge-inset: calc(var(--edge-pad) + max(0px, (100vw - var(--container-width)) / 2));
	}

	@media (min-width: 900px) {
		:root {
			--section-padding-block: 6.5rem;
			--edge-pad: 2.5rem;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
	}

	html {
		scroll-behavior: smooth;
	}

	section[id],
	#top {
		scroll-margin-top: 84px;
	}

	@media (min-width: 900px) {
		section[id],
		#top {
			scroll-margin-top: 104px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	body {
		background: var(--color-near-black);
		color: var(--color-text);
		font-family: var(--font-body);
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-display);
		margin: 0;
		color: inherit;
	}

	p {
		margin: 0;
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}

	.container {
		max-width: var(--container-width);
		margin-inline: auto;
		padding-inline: var(--edge-pad);
	}
</style>
