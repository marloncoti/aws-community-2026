---
import speakers from '../data/speakers.json';
import SpeakerCard from './SpeakerCard.astro';
---

<section class="speakers" id="ponentes">
	<div class="container">
		<p class="kicker">Comparten su conocimiento</p>
		<h2>Ponentes</h2>
		<p class="lead">Muy pronto anunciaremos el line-up completo de charlas y quienes las presentarán.</p>

		<div class="grid">
			{speakers.map((speaker) => <SpeakerCard speaker={speaker} />)}
		</div>
	</div>
</section>

<style>
	.speakers {
		padding-block: var(--section-padding-block);
		background: var(--color-ink-soft);
	}

	.kicker {
		font-family: var(--font-display);
		color: var(--color-orange);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	h2 {
		color: var(--color-text-inverse);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.lead {
		color: var(--color-text-inverse-muted);
		margin-top: 0.5rem;
		font-size: 1.05rem;
		max-width: 52ch;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin-top: 2.75rem;
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 900px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
