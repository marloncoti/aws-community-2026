---
// CTA a la agenda en tiempo real (sitio externo). Se usa en el hero de la home
// y en el encabezado de /agenda; va sobre fondo oscuro en los dos casos.
const LIVE_AGENDA_URL = 'https://agenda.aws.gt';
---

<div class="live-wrap">
<a class="live-cta" href={LIVE_AGENDA_URL} target="_blank" rel="noopener noreferrer">
	<span class="live-tag">
		<span class="live-dot" aria-hidden="true"></span>
		En vivo
	</span>
	<span class="live-copy">
		<span class="live-title">Agenda en tiempo real</span>
		<span class="live-text">Qué charla está pasando ahora en cada salón</span>
	</span>
	<svg class="live-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M7 17 17 7" />
		<path d="M8 7h9v9" />
	</svg>
</a>
<p class="live-hint">
	<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
		<path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
	</svg>
	Activa las notificaciones en la agenda para saber cuándo empieza tu próxima charla.
</p>
</div>

<style>
	.live-cta {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-left: 3px solid var(--color-orange);
		border-radius: 2px;
		background: rgba(15, 20, 28, 0.55);
		color: var(--color-text-inverse);
		text-decoration: none;
		transition: border-color 0.15s ease, background-color 0.15s ease;
	}

	.live-cta:hover {
		border-color: var(--color-orange);
		background: rgba(15, 20, 28, 0.75);
	}

	.live-cta:focus-visible {
		outline: 2px solid var(--color-text-inverse);
		outline-offset: 3px;
	}

	.live-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		padding: 0.25rem 0.55rem;
		background: var(--color-orange);
		color: var(--color-ink);
		font: 700 0.68rem var(--font-display);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.live-dot {
		position: relative;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-ink);
	}

	.live-dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--color-ink);
		animation: live-pulse 1.6s ease-out infinite;
	}

	@keyframes live-pulse {
		from { transform: scale(1); opacity: 0.7; }
		to { transform: scale(2.6); opacity: 0; }
	}

	.live-copy {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.live-title {
		font: 600 0.95rem var(--font-display);
	}

	.live-text {
		margin-top: 0.1rem;
		color: var(--color-text-inverse-muted);
		font-size: 0.8rem;
	}

	.live-arrow {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.live-cta:hover .live-arrow {
		color: var(--color-orange);
		transform: translate(2px, -2px);
	}

	.live-hint {
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		margin-top: 0.6rem;
		color: var(--color-text-inverse-muted);
		font-size: 0.8rem;
		line-height: 1.4;
	}

	.live-hint svg {
		flex-shrink: 0;
		margin-top: 0.1rem;
		color: var(--color-orange);
	}

	@media (prefers-reduced-motion: reduce) {
		.live-dot::after { animation: none; }
		.live-cta, .live-arrow { transition: none; }
		.live-cta:hover .live-arrow { transform: none; }
	}
</style>
