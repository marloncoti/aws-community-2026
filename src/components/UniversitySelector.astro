---
import universities from '../data/universities.json';

const defaultId = universities.find((u) => u.default)?.id ?? universities[0].id;
---

<div class="selector">
	<div class="list" role="tablist" aria-label="Selecciona tu universidad">
		<div class="list-track">
			{
				universities.map((university) => (
					<button
						type="button"
						class:list={['list-item', { active: university.id === defaultId }]}
						data-target={university.id}
						role="tab"
						aria-selected={university.id === defaultId}
					>
						<span class="list-mark" aria-hidden="true">
							{university.logo ? <img src={university.logo} alt="" /> : <span class="list-fallback">{university.shortName}</span>}
						</span>
						<span class="list-name">
							<span class="list-name-full">{university.name}</span>
							<span class="list-name-short">{university.shortName}</span>
						</span>
						<svg class="list-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14" />
							<path d="M13 6l6 6-6 6" />
						</svg>
					</button>
				))
			}
			{
				universities.map((university) => (
					<button
						type="button"
						class:list={['list-item', { active: university.id === defaultId }]}
						data-target={university.id}
						data-clone="true"
						aria-hidden="true"
						tabindex={-1}
					>
						<span class="list-mark" aria-hidden="true">
							{university.logo ? <img src={university.logo} alt="" /> : <span class="list-fallback">{university.shortName}</span>}
						</span>
						<span class="list-name">
							<span class="list-name-full">{university.name}</span>
							<span class="list-name-short">{university.shortName}</span>
						</span>
						<svg class="list-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14" />
							<path d="M13 6l6 6-6 6" />
						</svg>
					</button>
				))
			}
		</div>
	</div>

	<div class="panel">
		{
			universities.map((university) => (
				<div class:list={['panel-item', { active: university.id === defaultId }]} data-panel={university.id}>
					<div class="panel-head">
						<span class="panel-logo">
							{university.logo ? (
								<img src={university.logo} alt="" />
							) : (
								<span class="logo-fallback">{university.shortName}</span>
							)}
						</span>
						<p class="panel-title">{university.shortName}</p>
					</div>
					<p class="panel-tagline">{university.tagline}</p>
					<p class="description">{university.description}</p>
					<a class="cta" href={university.url} target="_blank" rel="noopener noreferrer">
						Registrarme
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14" />
							<path d="M13 6l6 6-6 6" />
						</svg>
					</a>
				</div>
			))
		}
	</div>
</div>

<script>
	const list = document.querySelector<HTMLElement>('.selector .list');
	const panels = document.querySelectorAll<HTMLElement>('.selector .panel-item');
	const panelEl = document.querySelector<HTMLElement>('.selector .panel');

	list?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.list-item');
		if (!button) return;

		const target = button.dataset.target;

		panels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === target));
		list.querySelectorAll<HTMLButtonElement>('.list-item').forEach((btn) => {
			const isActive = btn.dataset.target === target;
			btn.classList.toggle('active', isActive);
			btn.setAttribute('aria-selected', String(isActive));
		});

		panelEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	.selector {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		max-width: 34rem;
	}

	.panel {
		position: relative;
		border-radius: 10px;
		background: var(--color-ink);
		border: 1px solid rgba(255, 255, 255, 0.1);
		overflow: hidden;
		scroll-margin-top: calc(84px + 1rem);
	}

	@media (min-width: 900px) {
		.panel {
			scroll-margin-top: calc(104px + 1rem);
		}
	}

	.panel-item {
		display: none;
		position: relative;
		flex-direction: column;
		padding: 2rem 1.5rem;
	}

	.panel-item.active {
		display: flex;
	}

	.panel-item::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 70% 60% at 100% 0%, rgba(109, 74, 173, 0.4), transparent 65%);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.panel-head {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.panel-logo {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: var(--color-surface);
		overflow: hidden;
	}

	.panel-logo img {
		height: 30px;
		width: auto;
		max-width: 70%;
		object-fit: contain;
	}

	.logo-fallback {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--color-ink);
	}

	.panel-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.75rem;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--color-text-inverse);
		margin: 0;
	}

	.panel-tagline {
		position: relative;
		color: var(--color-orange);
		font-weight: 600;
		font-size: 0.95rem;
		margin-top: 1.5rem;
		max-width: 36rem;
	}

	.description {
		position: relative;
		color: var(--color-text-inverse-muted);
		margin-top: 0.9rem;
		font-size: 0.95rem;
		line-height: 1.6;
		flex: 1;
		max-width: 36rem;
	}

	.cta {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		max-width: 20rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--color-ink);
		background: var(--color-orange);
		padding: 0.9rem 1.4rem;
		border-radius: 8px;
		margin-top: 1.75rem;
		transition: background-color 0.15s ease;
	}

	.cta:hover {
		background: var(--color-orange-dark);
	}

	.cta svg {
		transition: transform 0.2s ease;
	}

	.cta:hover svg {
		transform: translateX(3px);
	}

	.list {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent 0%, black 6%, black 94%, transparent 100%);
		mask-image: linear-gradient(90deg, transparent 0%, black 6%, black 94%, transparent 100%);
	}

	.list-track {
		display: flex;
		align-items: center;
		width: max-content;
		gap: 0.65rem;
		animation: chips-scroll 22s linear infinite;
	}

	.list:hover .list-track {
		animation-play-state: paused;
	}

	@keyframes chips-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.list-track {
			animation: none;
		}

		.list {
			overflow-x: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}
	}

	.list-item {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: 0.6rem;
		font: inherit;
		text-align: left;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 999px;
		padding: 0.5rem 1rem 0.5rem 0.5rem;
		cursor: pointer;
		color: var(--color-text-inverse-muted);
		transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
	}

	.list-item:hover {
		border-color: rgba(255, 153, 0, 0.4);
	}

	.list-item.active {
		background: rgba(255, 153, 0, 0.08);
		border-color: var(--color-orange);
		color: var(--color-text-inverse);
	}

	.list-mark {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-surface);
		box-shadow: 0 0 0 3px var(--color-violet-deep);
		overflow: hidden;
	}

	.list-mark img {
		height: 20px;
		width: auto;
		max-width: 70%;
		object-fit: contain;
	}

	.list-fallback {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.6rem;
		color: var(--color-ink);
	}

	.list-name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.list-name-full {
		display: none;
	}

	.list-arrow {
		display: none;
	}

	@media (min-width: 900px) {
		.selector {
			max-width: none;
		}

		.panel-item {
			padding: 3rem 3.5rem;
		}

		.panel-head {
			gap: 1.5rem;
		}

		.panel-logo {
			width: 140px;
			height: 140px;
		}

		.panel-logo img {
			height: 68px;
		}

		.logo-fallback {
			font-size: 1.3rem;
		}

		.panel-title {
			font-size: 2.5rem;
		}

		.panel-tagline,
		.description {
			font-size: 1.05rem;
		}
	}
</style>
