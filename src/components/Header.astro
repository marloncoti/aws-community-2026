---
import logo from '../assets/brand/logo-awscd-2026.png';
import { Image } from 'astro:assets';

const general_register_url = 'https://c.proticket.store/tickets/free/o/b88ac5c2-573b-438a-8587-12248067b887/e/e8fe1d69-4870-4d27-a63e-e499c819c7cd/s/350e165d-dc95-4e2b-9c97-1e90d63c6b97?chart=ga&category=2c1a98d1-c186-42e1-983d-f901df4e35f6'
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="brand">
			<Image src={logo} alt="AWS Community Day Guatemala 2026" width={192} height={115} />
		</a>
		<nav class="nav">
			<div class="links">
				<a href="/#ponentes">Ponentes</a>
				<a href="/#patrocinadores">Patrocinadores</a>
				<a href="/#organizadores">Organizadores</a>
				<a href="/registro-universidades">Universidades</a>
			</div>
			<a class="cta" href={general_register_url} target="_blank" rel="noopener noreferrer">
				Regístrate sin Costo
				<svg class="icon-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="M13 6l6 6-6 6" />
				</svg>
			</a>
		</nav>
		<button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">
			<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 7h16" />
				<path d="M4 12h16" />
				<path d="M4 17h16" />
			</svg>
		</button>
	</div>
</header>

<script>
	const toggle = document.querySelector('.menu-toggle');
	const links = document.querySelector('.site-header .links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	links?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			links.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.site-header {
		position: fixed;
		inset-inline: 0;
		top: 0;
		z-index: 40;
		background: rgba(23, 33, 46, 0.45);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 0.5rem;
	}

	.brand :global(img) {
		height: 56px;
		width: auto;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.links {
		display: none;
	}

	.links.open {
		display: flex;
		flex-direction: column;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		gap: 0.25rem;
		padding: 0.75rem 1.25rem 1.25rem;
		background: rgba(20, 16, 28, 0.97);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.links a {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-text-inverse-muted);
		padding: 0.65rem 0;
		transition: color 0.15s ease;
	}

	.links a:hover {
		color: var(--color-orange);
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		color: var(--color-text-inverse);
		padding: 0.4rem;
		cursor: pointer;
		position: relative;
		z-index: 2;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--color-ink);
		background: var(--color-orange);
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.cta:hover {
		background: var(--color-orange-dark);
	}

	.cta .icon-arrow {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.cta:hover .icon-arrow {
		transform: translateX(3px);
	}

	@media (min-width: 900px) {
		.bar {
			padding-block: 0.75rem;
		}

		.brand :global(img) {
			height: 78px;
		}

		.menu-toggle {
			display: none;
		}

		.links {
			display: flex;
			flex-direction: row;
			position: static;
			gap: 1.75rem;
			padding: 0;
			background: none;
			backdrop-filter: none;
			border-bottom: none;
		}

		.links a {
			font-size: 0.85rem;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			padding: 0;
		}

		.cta {
			font-size: 0.9rem;
			padding: 0.65rem 1.4rem;
		}

	}
</style>
