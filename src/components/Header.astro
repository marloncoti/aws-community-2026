---
import logo from '../assets/brand/logo-awscd-2026.png';
import quetzal from '../assets/brand/quetzal.png';
import { Image } from 'astro:assets';
---

<header class="site-header">
	<Image src={quetzal} alt="" class="quetzal" widths={[160, 320]} sizes="200px" />
	<div class="container bar">
		<a href="#top" class="brand">
			<Image src={logo} alt="AWS Community Day Guatemala 2026" width={192} height={115} />
		</a>
		<nav class="nav">
			<a class="cta" href="https://c.proticket.store/1e90d63c6b97" target="_blank" rel="noopener noreferrer">
				Regístrate sin Costo
				<svg class="icon-arrow" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="M13 6l6 6-6 6" />
				</svg>
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset-inline: 0;
		top: 0;
		z-index: 40;
		background: rgba(23, 33, 46, 0.45);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 0.5rem;
	}

	.site-header :global(.quetzal) {
		position: absolute;
		top: 2px;
		right: 4%;
		z-index: 1;
		height: 70px;
		width: auto;
		pointer-events: none;
		filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
	}

	.brand :global(img) {
		height: 56px;
		width: auto;
	}

	.nav {
		display: flex;
		gap: 1.25rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--color-ink);
		background: var(--color-orange);
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.cta:hover {
		background: var(--color-orange-dark);
	}

	.cta .icon-arrow {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.cta:hover .icon-arrow {
		transform: translateX(3px);
	}

	@media (min-width: 900px) {
		.bar {
			padding-block: 0.75rem;
		}

		.brand :global(img) {
			height: 78px;
		}

		.cta {
			font-size: 0.9rem;
			padding: 0.65rem 1.4rem;
		}

		.site-header :global(.quetzal) {
			top: 4px;
			right: 6%;
			height: 100px;
		}
	}
</style>
