---
import keynotes from '../data/keynotes.json';
import KeynoteCard from './KeynoteCard.astro';

const total = keynotes.length;
---

<section class="keynotes" id="keynote" aria-label="Keynote speakers">
	<div class="glow" aria-hidden="true"></div>
	<div class="pattern" aria-hidden="true"></div>

	<div class="container">
		<div class="heading">
			<div>
				<p class="kicker">Keynote</p>
			</div>
			<p class="lead">Las voces que abren y cierran el día: referentes de AWS compartiendo hacia dónde va la nube.</p>
		</div>

		<keynote-slider data-interval="8000" style={`--interval: ${8000}ms`}>
			<div class="track" id="keynote-track" tabindex="0" aria-roledescription="carrusel" aria-label="Keynote speakers. Desliza para explorar.">
				{keynotes.map((keynote, index) => <KeynoteCard keynote={keynote} index={index} total={total} />)}
			</div>

			<div class="controls" hidden>
				<p class="counter"><strong>01</strong> <span>/ {String(total).padStart(2, '0')}</span></p>

				<div class="dots">
					{
						keynotes.map((keynote, index) => (
							<button class="dot" type="button" data-index={index} aria-controls="keynote-track" aria-label={`Ver keynote ${index + 1}: ${keynote.name}`}>
								<span class="fill" aria-hidden="true" />
							</button>
						))
					}
				</div>

				<div class="navigation">
					<button class="previous" type="button" aria-controls="keynote-track" aria-label="Keynote anterior"><span aria-hidden="true">←</span></button>
					<button class="next" type="button" aria-controls="keynote-track" aria-label="Keynote siguiente"><span aria-hidden="true">→</span></button>
				</div>
			</div>

			<p class="sr-only status" aria-live="polite" aria-atomic="true"></p>
		</keynote-slider>
	</div>
</section>

<script>
	class KeynoteSlider extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';

			const track = this.querySelector<HTMLElement>('.track')!;
			const slides = Array.from(this.querySelectorAll<HTMLElement>('.slide'));
			if (slides.length < 2) return;

			const controls = this.querySelector<HTMLElement>('.controls')!;
			const dots = Array.from(this.querySelectorAll<HTMLButtonElement>('.dot'));
			const previous = this.querySelector<HTMLButtonElement>('.previous')!;
			const next = this.querySelector<HTMLButtonElement>('.next')!;
			const counter = this.querySelector<HTMLElement>('.counter strong')!;
			const status = this.querySelector<HTMLElement>('.status')!;
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const interval = Number(this.dataset.interval) || 8000;

			let index = 0;
			let playing = !reduced.matches;
			let timer = 0;
			let scrollEnd = 0;
			let resizeEnd = 0;

			const label = (position: number) => `${String(position + 1).padStart(2, '0')}`;

			const update = () => {
				counter.textContent = label(index);
				status.textContent = `Keynote ${index + 1} de ${slides.length}`;
				slides.forEach((slide, position) => {
					slide.inert = position !== index;
				});
				dots.forEach((dot, position) => {
					dot.setAttribute('aria-current', String(position === index));
					const fill = dot.firstElementChild as HTMLElement;
					// reiniciar la animación de progreso del punto activo
					fill.style.animation = 'none';
					void fill.offsetWidth;
					fill.style.animation = '';
				});
			};

			const go = (target: number, smooth = true) => {
				index = (target + slides.length) % slides.length;
				track.scrollTo({
					left: slides[index].offsetLeft - slides[0].offsetLeft,
					behavior: smooth && !reduced.matches ? 'smooth' : 'instant',
				});
				update();
				play();
			};

			const play = () => {
				clearInterval(timer);
				if (!playing) return;
				timer = window.setInterval(() => go(index + 1), interval);
			};

			const stop = () => {
				playing = false;
				clearInterval(timer);
				this.dataset.autoplay = 'off';
			};

			const sync = () => {
				const offset = track.scrollLeft + slides[0].offsetLeft;
				const nearest = slides.reduce(
					(best, slide, position) =>
						Math.abs(slide.offsetLeft - offset) < Math.abs(slides[best].offsetLeft - offset) ? position : best,
					0,
				);
				if (nearest === index) return;
				index = nearest;
				update();
			};

			previous.addEventListener('click', () => {
				stop();
				go(index - 1);
			});
			next.addEventListener('click', () => {
				stop();
				go(index + 1);
			});
			dots.forEach((dot, position) =>
				dot.addEventListener('click', () => {
					stop();
					go(position);
				}),
			);

			track.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
				event.preventDefault();
				stop();
				go(index + (event.key === 'ArrowRight' ? 1 : -1));
			});

			track.addEventListener('pointerdown', stop, { once: true });
			this.addEventListener('focusin', stop, { once: true });

			track.addEventListener('scroll', () => {
				clearTimeout(scrollEnd);
				scrollEnd = window.setTimeout(sync, 120);
			});

			addEventListener('resize', () => {
				clearTimeout(resizeEnd);
				resizeEnd = window.setTimeout(() => go(index, false), 150);
			});

			// pausar el autoplay cuando la sección no está a la vista
			new IntersectionObserver(
				([entry]) => {
					if (!playing) return;
					if (entry.isIntersecting) play();
					else clearInterval(timer);
				},
				{ threshold: 0.35 },
			).observe(this);

			controls.hidden = false;
			update();
			play();
		}
	}

	customElements.define('keynote-slider', KeynoteSlider);
</script>

<style>
	.keynotes {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: var(--section-padding-block);
		background: var(--color-near-black);
		color: var(--color-text-inverse);
		border-block: 1px solid #ffffff16;
	}

	.glow {
		position: absolute;
		inset-block-start: -30%;
		inset-inline-end: -20%;
		width: min(760px, 90%);
		aspect-ratio: 1;
		background: radial-gradient(circle, rgba(109, 74, 173, 0.55), transparent 62%);
		mix-blend-mode: screen;
		z-index: -2;
	}

	.pattern {
		position: absolute;
		inset: 0;
		background: url('/images/pattern.svg') repeat;
		background-size: 420px;
		opacity: 0.05;
		mix-blend-mode: soft-light;
		z-index: -1;
	}

	.heading {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}

	.kicker {
		color: var(--color-orange);
		text-transform: uppercase;
		letter-spacing: 0.13em;
		font-size: 0.72rem;
		font-weight: 600;
		margin-bottom: 0.85rem;
	}

	h2 {
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.045em;
	}

	h2 span {
		display: block;
	}

	.lead {
		color: var(--color-text-inverse-muted);
		font-size: 0.95rem;
		max-width: 39ch;
	}

	keynote-slider {
		display: block;
	}

	.track {
		display: flex;
		gap: clamp(1.5rem, 5vw, 4rem);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.track:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 6px;
	}

	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid #ffffff25;
	}

	.controls[hidden] {
		display: none;
	}

	.counter {
		font-family: var(--font-display);
		font-variant-numeric: tabular-nums;
		font-size: 0.85rem;
		color: var(--color-text-inverse-muted);
		order: 1;
	}

	.counter strong {
		font-size: 1.35rem;
		color: var(--color-orange);
		margin-right: 0.15rem;
	}

	.dots {
		display: flex;
		gap: 0.5rem;
		order: 3;
		width: 100%;
	}

	.dot {
		flex: 1;
		height: 3px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: #ffffff26;
		cursor: pointer;
		position: relative;
		overflow: hidden;
	}

	.dot::after {
		/* área táctil de 44px sin engordar la barra */
		content: '';
		position: absolute;
		inset-block: -20px;
		inset-inline: 0;
	}

	.fill {
		display: block;
		height: 100%;
		width: 0;
		border-radius: inherit;
		background: var(--gradient-accent);
	}

	.dot[aria-current='true'] .fill {
		animation: keynote-progress var(--interval, 8000ms) linear forwards;
	}

	keynote-slider[data-autoplay='off'] .dot[aria-current='true'] .fill {
		animation: none;
		width: 100%;
	}

	@keyframes keynote-progress {
		from {
			width: 0;
		}
		to {
			width: 100%;
		}
	}

	.navigation {
		display: flex;
		gap: 0.75rem;
		order: 2;
	}

	.navigation button {
		width: 44px;
		min-height: 44px;
		font: 500 1.4rem var(--font-display);
		color: var(--color-text-inverse);
		background: transparent;
		border: 1px solid #ffffff40;
		border-radius: 5px;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.navigation button:hover {
		background: var(--color-orange);
		border-color: var(--color-orange);
		color: var(--color-near-black);
	}

	.navigation button:focus-visible,
	.dot:focus-visible {
		outline: 2px solid var(--color-orange);
		outline-offset: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 800px) {
		.dots {
			order: 2;
			width: auto;
			flex: 1;
			max-width: 340px;
		}

		.navigation {
			order: 3;
		}
	}

	@media (min-width: 1000px) {
		.heading {
			grid-template-columns: 1.3fr 1fr;
			align-items: end;
		}

		.lead {
			justify-self: end;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot[aria-current='true'] .fill {
			animation: none;
			width: 100%;
		}
	}
</style>
