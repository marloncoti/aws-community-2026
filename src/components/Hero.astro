---
import heroBackground from '../assets/brand/hero-background.png';
import { Image } from 'astro:assets';
---

<section class="hero" id="top">
	<Image
		src={heroBackground}
		alt=""
		class="hero-bg"
		widths={[640, 1024, 1600]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero-scrim"></div>
	<div class="hero-glow" aria-hidden="true"></div>
	<div class="hero-pattern" aria-hidden="true"></div>

	<div class="hero-content">
		<p class="badge">Guatemala · 2026</p>
		<h1>AWS Community Day<br />Guatemala</h1>
		<p class="lead">
			Un día para conectar con la comunidad de AWS en Guatemala: charlas técnicas,
			casos reales y networking con quienes construyen sobre la nube.
		</p>
		<div class="actions">
			<a class="btn-primary" href="https://c.proticket.store/1e90d63c6b97" target="_blank" rel="noopener noreferrer">Regístrate</a>
			<a class="btn-ghost" href="#patrocinadores">Ver patrocinadores</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 88svh;
		display: flex;
		align-items: center;
		overflow: hidden;
		background: var(--color-ink);
		clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
	}

	.hero :global(.hero-bg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 30%;
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(115deg, rgba(20, 16, 28, 0.85) 0%, rgba(20, 16, 28, 0.55) 30%, rgba(20, 16, 28, 0.15) 52%, rgba(20, 16, 28, 0) 68%),
			linear-gradient(0deg, rgba(20, 16, 28, 0.45) 0%, rgba(20, 16, 28, 0) 35%);
	}

	.hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 60% 55% at 12% 8%, rgba(109, 74, 173, 0.55), transparent 65%);
		mix-blend-mode: screen;
	}

	.hero-pattern {
		position: absolute;
		inset: 0;
		background-image: url('/images/pattern.svg');
		background-repeat: repeat;
		background-size: 380px;
		background-position: 0 0;
		opacity: 0.14;
		mix-blend-mode: soft-light;
		animation: pattern-drift 50s linear infinite;
		-webkit-mask-image: linear-gradient(100deg, black 0%, black 30%, transparent 55%);
		mask-image: linear-gradient(100deg, black 0%, black 30%, transparent 55%);
	}

	@keyframes pattern-drift {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 380px 380px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-pattern {
			animation: none;
		}
	}

	.hero-content {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		padding: 2rem var(--edge-pad) 2rem var(--edge-inset);
		max-width: 52rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		color: var(--color-text-inverse);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.4rem 0.85rem;
		border: 1px solid rgba(255, 153, 0, 0.5);
		border-radius: 999px;
		background: rgba(15, 20, 28, 0.35);
		margin-bottom: 1.5rem;
	}

	.badge::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-orange);
		margin-right: 0.5rem;
	}

	h1 {
		color: var(--color-text-inverse);
		font-size: clamp(2.25rem, 9vw, 3rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.lead {
		color: var(--color-text-inverse-muted);
		margin-top: 1.25rem;
		font-size: 1.05rem;
		max-width: 42ch;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.btn-primary,
	.btn-ghost {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		text-align: center;
		padding: 0.85rem 1.5rem;
		border-radius: 2px;
	}

	.btn-primary {
		background: var(--color-orange);
		color: var(--color-ink);
	}

	.btn-ghost {
		border: 1px solid rgba(245, 247, 250, 0.35);
		color: var(--color-text-inverse);
	}

	@media (min-width: 640px) {
		.actions {
			flex-direction: row;
		}

		.btn-primary,
		.btn-ghost {
			padding: 0.9rem 2rem;
		}
	}

	@media (min-width: 900px) {
		.hero {
			clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
		}

		h1 {
			font-size: clamp(3rem, 5vw, 4rem);
		}

		.lead {
			font-size: 1.1rem;
		}
	}

	@media (min-width: 1280px) {
		h1 {
			font-size: clamp(4rem, 4.5vw, 4.75rem);
		}

		.lead {
			font-size: 1.2rem;
		}
	}

	@media (min-width: 1600px) {
		h1 {
			font-size: clamp(4.75rem, 4vw, 5.5rem);
		}
	}
</style>
