---
import heroBackground from '../assets/brand/hero-background.png';
import quetzal from '../assets/brand/quetzal.png';
import { Image } from 'astro:assets';

const general_register_url = 'https://c.proticket.store/tickets/free/o/b88ac5c2-573b-438a-8587-12248067b887/e/e8fe1d69-4870-4d27-a63e-e499c819c7cd/s/350e165d-dc95-4e2b-9c97-1e90d63c6b97?chart=ga&category=2c1a98d1-c186-42e1-983d-f901df4e35f6'
---

<section class="hero" id="top">
	<Image
		src={heroBackground}
		alt=""
		class="hero-bg"
		widths={[640, 1024, 1600]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero-scrim"></div>
	<div class="hero-glow" aria-hidden="true"></div>
	<div class="hero-pattern" aria-hidden="true"></div>
	<Image src={quetzal} alt="" class="hero-quetzal" widths={[160, 240]} sizes="140px" />

	<div class="hero-content">
		<p class="badge">Guatemala · 2026</p>
		<h1>AWS Community Day<br /><span class="text-gradient">Guatemala</span></h1>
		<p class="lead">
			Un día para conectar con la comunidad de AWS en Guatemala: charlas técnicas,
			casos reales y networking con quienes construyen sobre la nube.
		</p>
		<div class="actions">
			<a class="btn-primary" href={general_register_url} target="_blank" rel="noopener noreferrer">
				Registro Público General
				<svg class="icon-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="M13 6l6 6-6 6" />
				</svg>
			</a>
			<a class="btn-secondary" href="/registro-universidades">
				Registro Comunidad Universitaria
				<svg class="icon-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="M13 6l6 6-6 6" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 88svh;
		display: flex;
		align-items: center;
		overflow: hidden;
		background: var(--color-near-black);
	}

	.hero :global(.hero-bg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 22%;
	}

	@media (min-width: 1400px) {
		.hero {
			min-height: max(88svh, 48vw);
		}
	}

	.hero-scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(115deg, rgba(20, 16, 28, 0.85) 0%, rgba(20, 16, 28, 0.55) 30%, rgba(20, 16, 28, 0.15) 52%, rgba(20, 16, 28, 0) 68%),
			linear-gradient(0deg, rgba(20, 16, 28, 0.45) 0%, rgba(20, 16, 28, 0) 35%);
	}

	.hero-glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 60% 55% at 12% 8%, rgba(109, 74, 173, 0.55), transparent 65%);
		mix-blend-mode: screen;
	}

	.hero-pattern {
		position: absolute;
		inset: 0;
		background-image: url('/images/pattern.svg');
		background-repeat: repeat;
		background-size: 560px;
		background-position: 0 0;
		opacity: 0.16;
		mix-blend-mode: soft-light;
		animation: pattern-drift 50s linear infinite;
		-webkit-mask-image: linear-gradient(100deg, black 0%, black 30%, transparent 55%);
		mask-image: linear-gradient(100deg, black 0%, black 30%, transparent 55%);
	}

	@keyframes pattern-drift {
		from {
			background-position: 0 0;
		}
		to {
			background-position: 560px 560px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-pattern {
			animation: none;
		}
	}

	.hero :global(.hero-quetzal) {
		position: absolute;
		width: 90px;
		height: auto;
		pointer-events: none;
		filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.45));
		animation: hero-quetzal-fly 20s ease-in-out infinite;
	}

	@keyframes hero-quetzal-fly {
		0% {
			left: 58%;
			top: 18%;
			transform: rotate(-4deg) scale(0.9);
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		32% {
			left: 78%;
			top: 10%;
			transform: rotate(3deg) scale(1);
		}
		58% {
			left: 90%;
			top: 24%;
			transform: rotate(-7deg) scale(0.95);
		}
		80% {
			left: 70%;
			top: 32%;
			transform: rotate(5deg) scale(1);
		}
		92% {
			opacity: 1;
		}
		100% {
			left: 58%;
			top: 18%;
			transform: rotate(-4deg) scale(0.9);
			opacity: 0;
		}
	}

	@media (min-width: 900px) {
		.hero :global(.hero-quetzal) {
			width: 130px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero :global(.hero-quetzal) {
			animation: none;
			left: 78%;
			top: 12%;
			opacity: 1;
		}
	}

	.hero-content {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		padding: 2rem var(--edge-pad) 2rem var(--edge-inset);
		max-width: 52rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		color: var(--color-text-inverse);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.4rem 0.85rem;
		border: 1px solid rgba(255, 153, 0, 0.5);
		border-radius: 999px;
		background: rgba(15, 20, 28, 0.35);
		margin-bottom: 1.5rem;
	}

	.badge::before {
		content: '';
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-orange);
		margin-right: 0.5rem;
	}

	.text-gradient {
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	h1 {
		color: var(--color-text-inverse);
		font-size: clamp(2.25rem, 9vw, 3rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.01em;
	}

	.lead {
		color: var(--color-text-inverse-muted);
		margin-top: 1.25rem;
		font-size: 1.05rem;
		max-width: 42ch;
	}

	.actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.btn-primary,
	.btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		text-align: center;
		padding: 0.85rem 1.5rem;
		border-radius: 2px;
	}

	.btn-primary {
		background: var(--color-orange);
		color: var(--color-ink);
	}

	.btn-secondary {
		background: transparent;
		color: var(--color-text-inverse);
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

	.btn-secondary:hover {
		border-color: var(--color-orange);
		color: var(--color-orange);
	}

	.icon-arrow {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.btn-primary:hover .icon-arrow,
	.btn-secondary:hover .icon-arrow {
		transform: translateX(3px);
	}

	@media (min-width: 480px) {
		.actions {
			flex-direction: row;
			flex-wrap: wrap;
		}
	}

	@media (min-width: 640px) {
		.btn-primary,
		.btn-secondary {
			padding: 0.9rem 2rem;
		}
	}

	@media (min-width: 900px) {
		h1 {
			font-size: clamp(3rem, 5vw, 4rem);
		}

		.lead {
			font-size: 1.1rem;
		}
	}

	@media (min-width: 1280px) {
		h1 {
			font-size: clamp(4rem, 4.5vw, 4.75rem);
		}

		.lead {
			font-size: 1.2rem;
		}
	}

	@media (min-width: 1600px) {
		h1 {
			font-size: clamp(4.75rem, 4vw, 5.5rem);
		}
	}
</style>
