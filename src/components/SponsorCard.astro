---
interface Sponsor {
	id: string;
	name: string;
	tier: 'diamond' | 'gold' | 'silver';
	logo: string;
	url?: string;
}

interface Props {
	sponsor: Sponsor;
}

const { sponsor } = Astro.props;
const Tag = sponsor.url ? 'a' : 'div';
const linkProps = sponsor.url ? { href: sponsor.url, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class={`card tier-${sponsor.tier}`} {...linkProps}>
	<img src={sponsor.logo} alt={sponsor.name} loading="lazy" />
</Tag>

<style>
	.card {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 3px solid var(--tier-color, var(--color-border));
		border-radius: 8px;
		padding: 1.5rem;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		box-shadow: 0 16px 28px -12px rgba(0, 0, 0, 0.45);
	}

	.card img {
		height: 48px;
		width: auto;
		max-width: 100%;
		object-fit: contain;
	}

	.tier-diamond,
	.tier-gold,
	.tier-silver {
		min-height: 130px;
	}

	@media (min-width: 640px) {
		.card img {
			height: 56px;
		}
	}

	.tier-diamond {
		--tier-color: var(--color-orange);
	}

	.tier-gold {
		--tier-color: var(--color-violet);
	}

	.tier-silver {
		--tier-color: rgba(255, 255, 255, 0.3);
	}
</style>
