---
interface Keynote {
	id: string;
	name: string;
	role?: string;
	org?: string;
	talk?: string;
	photo?: string;
	linkedin?: string;
}

interface Props {
	keynote: Keynote;
	index: number;
	total: number;
}

const { keynote, index, total } = Astro.props;
const isPlaceholder = !keynote.photo;
const position = String(index + 1).padStart(2, '0');
---

<article class="slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${total}: ${keynote.name}`}>
	<div class="frame">
		<span class="number">{position}</span>
		<div class="photo">
			{
				isPlaceholder ? (
					<div class="placeholder">
						<svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
							<circle cx="12" cy="8" r="4" />
							<path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" />
						</svg>
					</div>
				) : (
					<img src={keynote.photo} alt={keynote.name} width="800" height="800" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
				)
			}
		</div>
		<p class="plate">{keynote.name}</p>
	</div>

	<div class="info">
		<p class="kicker">Keynote Speaker</p>
		<h3 class:list={['name', { muted: isPlaceholder }]}>{keynote.name}</h3>
		{
			(keynote.role || keynote.org) && (
				<p class="role">
					{keynote.role}
					{keynote.role && keynote.org && <span class="at"> @ </span>}
					{keynote.org}
				</p>
			)
		}
		<p class:list={['talk', { pending: !keynote.talk }]}>{keynote.talk || 'Tema por confirmar'}</p>
		{
			keynote.linkedin && (
				<a class="linkedin" href={keynote.linkedin} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
						<path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.11 1 2.48 1 4.98 2.12 4.98 3.5zM.4 8.24H4.6V23H.4V8.24zM8.34 8.24h4.03v2.01h.06c.56-1.06 1.93-2.18 3.98-2.18 4.25 0 5.03 2.8 5.03 6.44V23h-4.2v-6.68c0-1.59-.03-3.64-2.22-3.64-2.22 0-2.56 1.74-2.56 3.53V23H8.34V8.24z" />
					</svg>
					<span>LinkedIn</span>
					<span class="sr-only">de {keynote.name}</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.slide {
		flex: 0 0 100%;
		min-width: 0;
		scroll-snap-align: center;
		scroll-snap-stop: always;
		display: grid;
		gap: 2rem;
		align-items: center;
		padding-block: 0.5rem 1rem;
	}

	/* ---- marco de la foto ---- */
	.frame {
		position: relative;
		justify-self: center;
		width: min(280px, 78%);
		padding: 2.1rem 0.75rem 0.75rem;
		border-radius: 20px;
		background: linear-gradient(165deg, var(--color-magenta) 0%, #b5276a 55%, #7c2a68 100%);
		box-shadow: 0 28px 55px -22px rgba(0, 0, 0, 0.75);
		transform: rotate(-2.5deg);
	}

	.number {
		position: absolute;
		top: 0.7rem;
		left: 1.05rem;
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		color: rgba(255, 255, 255, 0.85);
	}

	.photo {
		position: relative;
		aspect-ratio: 1;
		border-radius: 12px;
		overflow: hidden;
		background: var(--color-violet-deep);
	}

	.photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.3);
	}

	.plate {
		margin: 0;
		padding-block: 0.6rem 0.35rem;
		text-align: center;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.92);
	}

	/* ---- texto ---- */
	.info {
		text-align: center;
	}

	.kicker {
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: var(--color-text-inverse-muted);
	}

	.name {
		margin-top: 0.45rem;
		font-size: clamp(2rem, 8vw, 3.4rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.025em;
		color: var(--color-text-inverse);
	}

	.name.muted {
		color: var(--color-text-inverse-muted);
	}

	.role {
		margin-top: 0.7rem;
		font-size: 1rem;
		color: var(--color-text-inverse-muted);
	}

	.at {
		color: rgba(255, 255, 255, 0.35);
	}

	.talk {
		margin-top: 1.1rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 4.5vw, 1.85rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.015em;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.talk.pending {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		background: none;
		color: var(--color-text-inverse-muted);
		opacity: 0.75;
	}

	.linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.55rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-inverse);
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.linkedin:hover,
	.linkedin:focus-visible {
		background: var(--color-orange);
		border-color: var(--color-orange);
		color: var(--color-ink);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 800px) {
		.slide {
			grid-template-columns: minmax(0, 355px) minmax(0, 1fr);
			gap: 3.5rem;
			padding-block: 1rem 1.5rem;
		}

		.frame {
			width: 100%;
			justify-self: start;
		}

		.info {
			text-align: left;
		}

		.name {
			font-size: clamp(2.4rem, 4.4vw, 3.6rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.frame {
			transform: none;
		}
	}
</style>
