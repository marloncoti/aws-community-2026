---
interface Keynote {
	id: string;
	name: string;
	role?: string;
	org?: string;
	talk?: string;
	photo?: string;
	linkedin?: string;
}

interface Props {
	keynote: Keynote;
	index: number;
	total: number;
}

const { keynote, index, total } = Astro.props;
const isPlaceholder = !keynote.photo;
---

<article class="slide" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${total}: ${keynote.name}`}>
	<div class="figure">
		<span class="glow" aria-hidden="true"></span>
		{
			isPlaceholder ? (
				<div class="placeholder">
					<svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
						<circle cx="12" cy="8" r="4" />
						<path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" />
					</svg>
				</div>
			) : (
				<img class="cutout" src={keynote.photo} alt={keynote.name} width="800" height="800" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" />
			)
		}
		<span class="floor" aria-hidden="true"></span>
	</div>

	<div class="info">
		<h3 class:list={['name', { muted: isPlaceholder }]}>{keynote.name}</h3>
		{
			(keynote.role || keynote.org) && (
				<p class="role">
					{keynote.role}
					{keynote.role && keynote.org && <span class="at"> @ </span>}
					{keynote.org}
				</p>
			)
		}
		<p class:list={['talk', { pending: !keynote.talk }]}>{keynote.talk || 'Tema por confirmar'}</p>
		{
			keynote.linkedin && (
				<a class="linkedin" href={keynote.linkedin} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
						<path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.11 1 2.48 1 4.98 2.12 4.98 3.5zM.4 8.24H4.6V23H.4V8.24zM8.34 8.24h4.03v2.01h.06c.56-1.06 1.93-2.18 3.98-2.18 4.25 0 5.03 2.8 5.03 6.44V23h-4.2v-6.68c0-1.59-.03-3.64-2.22-3.64-2.22 0-2.56 1.74-2.56 3.53V23H8.34V8.24z" />
					</svg>
					<span>LinkedIn</span>
					<span class="sr-only">de {keynote.name}</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.slide {
		flex: 0 0 100%;
		min-width: 0;
		scroll-snap-align: center;
		scroll-snap-stop: always;
		display: grid;
		gap: 0.75rem;
		align-items: center;
		padding-block: 0.5rem 1rem;
	}

	/* ---- figura recortada, estilo "character hero" ---- */
	.figure {
		position: relative;
		justify-self: center;
		width: min(380px, 92%);
		aspect-ratio: 4 / 5;
	}

	.glow {
		position: absolute;
		inset: 2% -18% 0;
		z-index: 0;
		background:
			radial-gradient(38% 30% at 50% 26%, rgba(140, 100, 220, 0.55), transparent 70%),
			radial-gradient(68% 58% at 50% 42%, rgba(109, 74, 173, 0.55), transparent 68%);
		filter: blur(12px);
		opacity: 0.6;
		transition: opacity 0.5s ease, transform 0.5s ease;
	}

	.floor {
		position: absolute;
		inset-inline: -20%;
		bottom: -4%;
		height: 34%;
		z-index: 0;
		background: radial-gradient(46% 100% at 50% 100%, rgba(255, 153, 0, 0.11), transparent 78%);
		filter: blur(18px);
		mix-blend-mode: screen;
	}

	.cutout {
		position: relative;
		z-index: 1;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
		/* los hombros se disuelven en el fondo de la sección. El degradado es
		   largo a propósito: uno corto deja una línea recta visible donde
		   termina la foto */
		-webkit-mask-image: linear-gradient(to bottom, #000 34%, rgba(0, 0, 0, 0.62) 62%, rgba(0, 0, 0, 0.24) 78%, rgba(0, 0, 0, 0.06) 88%, transparent 95%);
		mask-image: linear-gradient(to bottom, #000 34%, rgba(0, 0, 0, 0.62) 62%, rgba(0, 0, 0, 0.24) 78%, rgba(0, 0, 0, 0.06) 88%, transparent 95%);
		filter: contrast(1.04) saturate(1.02) drop-shadow(0 22px 38px rgba(0, 0, 0, 0.7));
		transition: transform 0.5s ease;
	}

	.slide:hover .glow {
		opacity: 0.85;
		transform: scale(1.04);
	}

	.slide:hover .cutout {
		transform: translateY(-4px);
	}

	.placeholder {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		color: rgba(255, 255, 255, 0.25);
	}

	/* ---- texto ---- */
	.info {
		position: relative;
		z-index: 2;
		text-align: center;
	}

	.name {
		margin-top: 0;
		font-size: clamp(2rem, 8vw, 3.4rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.025em;
		color: var(--color-text-inverse);
		text-shadow: 0 4px 24px rgba(0, 0, 0, 0.9);
	}

	.name.muted {
		color: var(--color-text-inverse-muted);
	}

	.role {
		margin-top: 0.7rem;
		font-size: 1rem;
		color: var(--color-text-inverse-muted);
	}

	.at {
		color: rgba(255, 255, 255, 0.35);
	}

	.talk {
		margin-top: 1.1rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 4.5vw, 1.85rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.015em;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.talk.pending {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		background: none;
		color: var(--color-text-inverse-muted);
		opacity: 0.75;
	}

	.linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
		padding: 0.55rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-text-inverse);
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.linkedin:hover,
	.linkedin:focus-visible {
		background: var(--color-orange);
		border-color: var(--color-orange);
		color: var(--color-ink);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 800px) {
		.slide {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 3rem;
			padding-block: 0;
			align-items: center;
		}

		.figure {
			width: 100%;
			max-width: 470px;
			justify-self: start;
		}

		.info {
			text-align: left;
			padding-bottom: 2rem;
		}

		.name {
			font-size: clamp(2.4rem, 4.4vw, 3.6rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.glow,
		.cutout {
			transition: none;
		}

		.slide:hover .cutout {
			transform: none;
		}
	}
</style>
