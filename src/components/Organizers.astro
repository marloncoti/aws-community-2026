---
import organizers from '../data/organizers.json';
import OrganizerCard from './OrganizerCard.astro';
---

<section class="organizers" id="organizadores">
	<div class="container">
		<p class="kicker">El equipo detrás del evento</p>
		<h2>Organizadores</h2>

		<div class="grid">
			{organizers.map((organizer) => <OrganizerCard organizer={organizer} />)}
		</div>
	</div>
</section>

<style>
	.organizers {
		padding-block: var(--section-padding-block);
		background: var(--color-violet-deep);
	}

	.kicker {
		font-family: var(--font-display);
		color: var(--color-orange);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	h2 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-inverse);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5rem 1rem;
		margin-top: 3rem;
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (min-width: 900px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
</style>
