---
/**
 * Diseño ALTERNO del bloque de keynotes: la foto con su fondo original dentro
 * de un marco magenta (la primera versión del slider).
 *
 * El diseño por defecto es `Keynotes.astro` (recorte sobre negro, estilo
 * infolavelada). Los dos tienen la misma cabecera, el mismo carrusel y no
 * reciben props, así que se cambia de uno a otro comentando/descomentando un
 * import en `src/pages/index.astro`. Ver AGENTS.md.
 */
import keynotes from '../data/keynotes.json';
import KeynoteCard from './KeynoteFramedCard.astro';

const total = keynotes.length;
---

<section class="keynotes" id="keynote" aria-labelledby="keynote-title">
	<div class="glow" aria-hidden="true"></div>
	<div class="pattern" aria-hidden="true"></div>

	<div class="container">
		<div class="heading">
			<h2 class="wordmark" id="keynote-title">Keynote</h2>
			<p class="lead">Las voces que abren y cierran el día: referentes de AWS compartiendo hacia dónde va la nube.</p>
		</div>

		<keynote-slider-framed data-interval="8000" style={`--interval: ${8000}ms`}>
			<div class="track" id="keynote-track" tabindex="0" aria-roledescription="carrusel" aria-label="Keynote speakers. Desliza para explorar.">
				{keynotes.map((keynote, index) => <KeynoteCard keynote={keynote} index={index} total={total} />)}
			</div>

			<div class="controls" hidden>
				<p class="counter"><strong>01</strong> <span>/ {String(total).padStart(2, '0')}</span></p>

				<div class="dots">
					{
						keynotes.map((keynote, index) => (
							<button class="dot" type="button" data-index={index} aria-controls="keynote-track" aria-label={`Ver keynote ${index + 1}: ${keynote.name}`}>
								<span class="fill" aria-hidden="true" />
							</button>
						))
					}
				</div>

				<div class="navigation">
					<button class="previous" type="button" aria-controls="keynote-track" aria-label="Keynote anterior"><span aria-hidden="true">←</span></button>
					<button class="next" type="button" aria-controls="keynote-track" aria-label="Keynote siguiente"><span aria-hidden="true">→</span></button>
				</div>
			</div>

			<p class="sr-only status" aria-live="polite" aria-atomic="true"></p>
		</keynote-slider-framed>
	</div>
</section>

<script>
	class KeynoteSliderFramed extends HTMLElement {
		connectedCallback() {
			if (this.dataset.ready) return;
			this.dataset.ready = 'true';

			const track = this.querySelector<HTMLElement>('.track')!;
			const slides = Array.from(this.querySelectorAll<HTMLElement>('.slide'));
			if (slides.length < 2) return;

			const controls = this.querySelector<HTMLElement>('.controls')!;
			const dots = Array.from(this.querySelectorAll<HTMLButtonElement>('.dot'));
			const previous = this.querySelector<HTMLButtonElement>('.previous')!;
			const next = this.querySelector<HTMLButtonElement>('.next')!;
			const counter = this.querySelector<HTMLElement>('.counter strong')!;
			const status = this.querySelector<HTMLElement>('.status')!;
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const interval = Number(this.dataset.interval) || 8000;

			let index = 0;
			let playing = !reduced.matches;
			let timer = 0;
			let scrollEnd = 0;
			let resizeEnd = 0;

			const label = (position: number) => `${String(position + 1).padStart(2, '0')}`;

			const update = () => {
				counter.textContent = label(index);
				status.textContent = `Keynote ${index + 1} de ${slides.length}`;
				slides.forEach((slide, position) => {
					slide.inert = position !== index;
				});
				dots.forEach((dot, position) => {
					dot.setAttribute('aria-current', String(position === index));
					const fill = dot.firstElementChild as HTMLElement;
					// reiniciar la animación de progreso del punto activo
					fill.style.animation = 'none';
					void fill.offsetWidth;
					fill.style.animation = '';
				});
			};

			const go = (target: number, smooth = true) => {
				index = (target + slides.length) % slides.length;
				track.scrollTo({
					left: slides[index].offsetLeft - slides[0].offsetLeft,
					behavior: smooth && !reduced.matches ? 'smooth' : 'instant',
				});
				update();
				play();
			};

			const play = () => {
				clearInterval(timer);
				if (!playing) return;
				timer = window.setInterval(() => go(index + 1), interval);
			};

			const stop = () => {
				playing = false;
				clearInterval(timer);
				this.dataset.autoplay = 'off';
			};

			const sync = () => {
				const offset = track.scrollLeft + slides[0].offsetLeft;
				const nearest = slides.reduce(
					(best, slide, position) =>
						Math.abs(slide.offsetLeft - offset) < Math.abs(slides[best].offsetLeft - offset) ? position : best,
					0,
				);
				if (nearest === index) return;
				index = nearest;
				update();
			};

			previous.addEventListener('click', () => {
				stop();
				go(index - 1);
			});
			next.addEventListener('click', () => {
				stop();
				go(index + 1);
			});
			dots.forEach((dot, position) =>
				dot.addEventListener('click', () => {
					stop();
					go(position);
				}),
			);

			track.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
				event.preventDefault();
				stop();
				go(index + (event.key === 'ArrowRight' ? 1 : -1));
			});

			track.addEventListener('pointerdown', stop, { once: true });
			this.addEventListener('focusin', stop, { once: true });

			track.addEventListener('scroll', () => {
				clearTimeout(scrollEnd);
				scrollEnd = window.setTimeout(sync, 120);
			});

			addEventListener('resize', () => {
				clearTimeout(resizeEnd);
				resizeEnd = window.setTimeout(() => go(index, false), 150);
			});

			// pausar el autoplay cuando la sección no está a la vista
			new IntersectionObserver(
				([entry]) => {
					if (!playing) return;
					if (entry.isIntersecting) play();
					else clearInterval(timer);
				},
				{ threshold: 0.35 },
			).observe(this);

			controls.hidden = false;
			update();
			play();
		}
	}

	customElements.define('keynote-slider-framed', KeynoteSliderFramed);
</script>

<style>
	.keynotes {
		/* ---- tono del bloque ----------------------------------------------
		   Morado intermedio: más oscuro que el resto del bloque claro que
		   probamos, pero bastante más claro que el near-black del diseño A y
		   que el violet-deep de la sección de ponentes, así que el bloque
		   sigue cortando. Además acerca la luminancia del fondo de las fotos
		   (blanco, gris de estudio) a la de la sección, que era lo que hacía
		   que sobre negro parecieran recuadros pegados.

		   Para probar otro tono, cambiar solo estas siete variables:
		     · morado (actual):   #211936 · texto claro
		     · pasos más claros:  #332852 / #3d2f63 / #4a3a72

		   Ojo: este tono ya es más OSCURO que el violet-deep con el que
		   empatan los bloques vecinos, así que el degradado ahora hunde el
		   centro en vez de levantarlo. Funciona igual —los bordes siguen
		   empatando—, pero si se baja más hay que bajar también `--kf-edge`
		   o la diferencia entre centro y bordes se vuelve un bandeo obvio.
		     · lavanda claro:         #ece7f6 · texto #241b33 · líneas #d8cdec
		                              · chip rgba(26,34,48,.16)
		   La palabra gigante no usa estas variables: va con `--gradient-accent`,
		   el mismo degradado que "Guatemala" en el hero.
		   -------------------------------------------------------------------- */
		--kf-surface: #211936;
		--kf-text: var(--color-text-inverse);
		--kf-muted: #c6bcdd;
		--kf-line: rgba(255, 255, 255, 0.22);
		--kf-accent: var(--color-orange);
		--kf-chip: rgba(255, 255, 255, 0.22);
		/* color con el que empatan los bloques de arriba y de abajo: el de
		   EventVideo termina en violet-deep y el de ponentes arranca en
		   violet-deep, así que el degradado puede ser simétrico */
		--kf-edge: var(--color-violet-deep);

		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: var(--section-padding-block);
		/* sin cortes: el bloque sube al morado medio y vuelve a bajar para
		   empatar con el bloque anterior y el siguiente. Nada de border-block
		   aquí: una línea partiría la unión que busca el degradado. */
		background: linear-gradient(
			180deg,
			var(--kf-edge) 0%,
			var(--kf-surface) 24%,
			var(--kf-surface) 72%,
			var(--kf-edge) 100%
		);
		color: var(--kf-text);
	}

	.glow {
		position: absolute;
		inset-block-start: -34%;
		inset-inline-end: -22%;
		width: min(820px, 92%);
		aspect-ratio: 1;
		background: radial-gradient(circle, rgba(190, 160, 255, 0.28), transparent 64%);
		mix-blend-mode: screen;
		z-index: -2;
	}

	.pattern {
		position: absolute;
		inset: 0;
		background: url('/images/pattern.svg') repeat;
		background-size: 420px;
		opacity: 0.06;
		mix-blend-mode: soft-light;
		z-index: -1;
		/* la textura también tiene que desaparecer en los bordes, o su corte
		   marca la unión aunque el color ya empate */
		-webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
		mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
	}

	/* El bloque que sigue (ponentes) trae una línea de 1px en su borde superior
	   que parte justo la unión que busca el degradado. Con este diseño sobra:
	   los dos bloques terminan y empiezan en el mismo color. Va en :global
	   porque es de otro componente, y solo se carga cuando este diseño está
	   activo.

	   Dos detalles que costaron: el combinador tiene que ser `~` y no `+`
	   porque Astro deja el <script> del carrusel entre las dos secciones; y
	   hay que pisar la propiedad lógica (`border-block-start-color`), que es
	   con la que la vecina la declara. */
	section.keynotes ~ :global(section.speakers) {
		border-block-start-color: transparent;
		border-top-color: transparent;
	}

	.heading {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}

	/* El título de la sección ES la palabra gigante, con los mismos colores que
	   "Guatemala" en el hero. Va invertido respecto del hero —naranja a la
	   izquierda— porque de ese lado cae el paspartú magenta del retrato y los
	   dos magentas se fundían.

	   Ojo con el line-height < 1: los glifos se salen por arriba de su caja y
	   se ven cortados en plano. El padding les devuelve el aire. */
	.wordmark {
		margin: 0;
		padding-top: 0.14em;
		font-family: var(--font-display);
		font-size: clamp(3rem, 11vw, 9rem);
		font-weight: 700;
		line-height: 0.82;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		background: linear-gradient(90deg, var(--color-orange), var(--color-magenta));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.lead {
		color: var(--kf-muted);
		font-size: 0.95rem;
		max-width: 39ch;
	}

	keynote-slider-framed {
		display: block;
	}

	.track {
		display: flex;
		gap: clamp(1.5rem, 5vw, 4rem);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}

	.track::-webkit-scrollbar {
		display: none;
	}

	.track:focus-visible {
		outline: 2px solid var(--kf-accent);
		outline-offset: 6px;
	}

	.controls {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--kf-line);
	}

	.controls[hidden] {
		display: none;
	}

	.counter {
		font-family: var(--font-display);
		font-variant-numeric: tabular-nums;
		font-size: 0.85rem;
		color: var(--kf-muted);
		order: 1;
	}

	.counter strong {
		font-size: 1.35rem;
		color: var(--kf-accent);
		margin-right: 0.15rem;
	}

	.dots {
		display: flex;
		gap: 0.5rem;
		order: 3;
		width: 100%;
	}

	.dot {
		flex: 1;
		height: 3px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: var(--kf-chip, rgba(255, 255, 255, 0.22));
		cursor: pointer;
		position: relative;
		overflow: hidden;
	}

	.dot::after {
		/* área táctil de 44px sin engordar la barra */
		content: '';
		position: absolute;
		inset-block: -20px;
		inset-inline: 0;
	}

	.fill {
		display: block;
		height: 100%;
		width: 0;
		border-radius: inherit;
		background: var(--gradient-accent);
	}

	.dot[aria-current='true'] .fill {
		animation: keynote-progress var(--interval, 8000ms) linear forwards;
	}

	keynote-slider-framed[data-autoplay='off'] .dot[aria-current='true'] .fill {
		animation: none;
		width: 100%;
	}

	@keyframes keynote-progress {
		from {
			width: 0;
		}
		to {
			width: 100%;
		}
	}

	.navigation {
		display: flex;
		gap: 0.75rem;
		order: 2;
	}

	.navigation button {
		width: 44px;
		min-height: 44px;
		font: 500 1.4rem var(--font-display);
		color: var(--kf-text);
		background: transparent;
		border: 1px solid var(--kf-line);
		border-radius: 5px;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.navigation button:hover {
		background: var(--color-orange);
		border-color: var(--color-orange);
		color: var(--color-near-black);
	}

	.navigation button:focus-visible,
	.dot:focus-visible {
		outline: 2px solid var(--kf-accent);
		outline-offset: 4px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (min-width: 800px) {
		.dots {
			order: 2;
			width: auto;
			flex: 1;
			max-width: 340px;
		}

		.navigation {
			order: 3;
		}
	}

	@media (min-width: 1000px) {
		.heading {
			grid-template-columns: minmax(0, 1fr) minmax(0, auto);
			align-items: end;
			gap: 2.5rem;
		}

		.lead {
			justify-self: end;
			max-width: 34ch;
			padding-bottom: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot[aria-current='true'] .fill {
			animation: none;
			width: 100%;
		}
	}
</style>
