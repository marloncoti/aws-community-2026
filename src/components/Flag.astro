---
/**
 * Bandera como SVG en línea, a partir de un código ISO 3166-1 alfa-2.
 *
 * No se usa el emoji de bandera (🇬🇹) porque **Windows no lo trae**: Segoe UI
 * Emoji no tiene glifos de bandera, así que el navegador dibuja las dos letras
 * del código ("GT") en vez de la bandera. Estos SVG se ven igual en todos lados.
 *
 * Los diseños están simplificados a propósito (se ven a 15-24px de ancho), pero
 * los escudos de México y Ecuador sí van insinuados: sin ellos México se
 * confunde con Italia y Ecuador es idéntico a Colombia.
 */
interface Props {
	code?: string;
	country?: string;
	width?: number;
	class?: string;
}

const { code, country, width = 22, class: className } = Astro.props;

function star(cx: number, cy: number, radius: number) {
	const points = [];
	for (let index = 0; index < 10; index++) {
		const r = index % 2 === 0 ? radius : radius * 0.382;
		const angle = (-90 + index * 36) * (Math.PI / 180);
		points.push(`${(cx + r * Math.cos(angle)).toFixed(2)} ${(cy + r * Math.sin(angle)).toFixed(2)}`);
	}
	return `M${points.join('L')}Z`;
}

const FLAGS: Record<string, string> = {
	GT: `<rect width="30" height="20" fill="#fff"/><rect width="10" height="20" fill="#4997d0"/><rect x="20" width="10" height="20" fill="#4997d0"/>
		<path d="M12.6 12.7 17.4 7.9M17.4 12.7 12.6 7.9" stroke="#7a8b6a" stroke-width=".9"/>
		<circle cx="15" cy="10.3" r="2.3" fill="none" stroke="#4b6b3a" stroke-width=".9"/>`,
	CO: `<rect width="30" height="10" fill="#fcd116"/><rect y="10" width="30" height="5" fill="#003893"/><rect y="15" width="30" height="5" fill="#ce1126"/>`,
	EC: `<rect width="30" height="10" fill="#ffdd00"/><rect y="10" width="30" height="5" fill="#0072ce"/><rect y="15" width="30" height="5" fill="#ef3340"/>
		<path d="M10.8 8.6c1.3-1.1 2.8-1.6 4.2-1.6s2.9.5 4.2 1.6c-1.3.1-2.4.4-3.1.8h-2.2c-.7-.4-1.8-.7-3.1-.8Z" fill="#8a6d3b"/>
		<path d="M13.1 9.7h3.8l-.6 2.7-1.3 1.2-1.3-1.2z" fill="#0072ce" stroke="#f2c500" stroke-width=".45"/>`,
	MX: `<rect width="30" height="20" fill="#fff"/><rect width="10" height="20" fill="#006847"/><rect x="20" width="10" height="20" fill="#ce1126"/>
		<ellipse cx="15" cy="10.2" rx="2.6" ry="2.9" fill="none" stroke="#6b8f3a" stroke-width=".9"/>
		<path d="M13.5 9.5c.9-.9 2.1-.9 3 0-.6.3-1 .8-1.5 1.5-.5-.7-.9-1.2-1.5-1.5Z" fill="#7b5a2e"/>`,
	PE: `<rect width="30" height="20" fill="#fff"/><rect width="10" height="20" fill="#d91023"/><rect x="20" width="10" height="20" fill="#d91023"/>`,
	CL: `<rect width="30" height="20" fill="#fff"/><rect y="10" width="30" height="10" fill="#d52b1e"/><rect width="10" height="10" fill="#0039a6"/>
		<path d="${star(5, 5, 3)}" fill="#fff"/>`,
	PA: `<rect width="30" height="20" fill="#fff"/><rect x="15" width="15" height="10" fill="#da121a"/><rect y="10" width="15" height="10" fill="#072357"/>
		<path d="${star(7.5, 5, 3)}" fill="#072357"/><path d="${star(22.5, 15, 3)}" fill="#da121a"/>`,
	CR: `<rect width="30" height="20" fill="#fff"/><rect width="30" height="3.4" fill="#002b7f"/><rect y="16.6" width="30" height="3.4" fill="#002b7f"/><rect y="6.8" width="30" height="6.4" fill="#ce1126"/>`,
};

const key = (code || '').toUpperCase();
const body = FLAGS[key];
const label = country || key;
const height = Math.round((width * 2) / 3);
---

{
	body && (
		<svg
			class:list={['flag-svg', className]}
			viewBox="0 0 30 20"
			width={width}
			height={height}
			role="img"
			aria-label={label}
			focusable="false"
		>
			<title>{label}</title>
			<Fragment set:html={body} />
			<rect x="0.4" y="0.4" width="29.2" height="19.2" fill="none" stroke="rgba(0,0,0,0.28)" stroke-width="0.8" />
		</svg>
	)
}

<style>
	.flag-svg {
		display: block;
		flex-shrink: 0;
	}
</style>
