---
import sponsors from '../data/sponsors.json';
import SponsorCard from './SponsorCard.astro';

const tiers = [
	{ key: 'diamond', label: 'Diamond' },
	{ key: 'gold', label: 'Gold' },
	{ key: 'silver', label: 'Silver' },
] as const;

const grouped = tiers
	.map((tier) => ({
		...tier,
		items: sponsors.filter((s) => s.tier === tier.key),
	}))
	.filter((tier) => tier.items.length > 0);
---

<section class="sponsors" id="patrocinadores">
	<div class="glow" aria-hidden="true"></div>
	<div class="container">
		<p class="kicker">Gracias por su apoyo</p>
		<h2>Patrocinadores</h2>

		{
			grouped.map((tier) => (
				<div class="tier-group">
					<p class={`tier-label tier-label-${tier.key}`}>{tier.label}</p>
					<div class={`grid grid-${tier.key}`}>
						{tier.items.map((sponsor) => (
							<SponsorCard sponsor={sponsor} />
						))}
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.sponsors {
		position: relative;
		overflow: hidden;
		padding-block: var(--section-padding-block);
		background: var(--color-ink-soft);
	}

	.glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 50% 45% at 90% 0%, rgba(109, 74, 173, 0.3), transparent 65%);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.container {
		position: relative;
	}

	.kicker {
		font-family: var(--font-display);
		color: var(--color-orange);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.8rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	h2 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-inverse);
	}

	.tier-group {
		margin-top: 2.75rem;
	}

	.tier-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-inverse-muted);
		margin-bottom: 1.25rem;
	}

	.tier-label::before {
		content: '';
		width: 22px;
		height: 3px;
		border-radius: 2px;
		background: var(--tier-color);
	}

	.tier-label-diamond {
		--tier-color: var(--color-orange);
	}

	.tier-label-gold {
		--tier-color: var(--color-violet);
	}

	.tier-label-silver {
		--tier-color: rgba(255, 255, 255, 0.3);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}
</style>
