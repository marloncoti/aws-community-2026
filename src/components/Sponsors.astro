---
import sponsors from '../data/sponsors.json';
import SponsorCard from './SponsorCard.astro';

const tiers = [
	{ key: 'diamond', label: 'Diamond' },
	{ key: 'gold', label: 'Gold' },
	{ key: 'silver', label: 'Silver' },
] as const;

const grouped = tiers
	.map((tier) => ({
		...tier,
		items: sponsors.filter((s) => s.tier === tier.key),
	}))
	.filter((tier) => tier.items.length > 0);
---

<section class="sponsors" id="patrocinadores">
	<div class="glow" aria-hidden="true"></div>
	<div class="container">
		<h2>Nuestros Patrocinadores</h2>
		<p class="lead">Gracias a estas increíbles organizaciones que hacen posible este evento.</p>

		{
			grouped.map((tier) => (
				<div class="tier-group">
					<p class={`tier-label tier-label-${tier.key}`}>{tier.label}</p>
					<div class={`grid grid-${tier.key}`}>
						{tier.items.map((sponsor) => (
							<SponsorCard sponsor={sponsor} />
						))}
					</div>
				</div>
			))
		}

		<div class="become-sponsor">
			<div class="become-copy">
				<p class="become-kicker">¿Tu empresa quiere sumarse?</p>
				<p class="become-text">Conviértete en patrocinador del AWS Community Day Guatemala 2026 y conecta con la comunidad tech más grande del país.</p>
			</div>
			<a class="become-cta" href="https://docs.google.com/forms/d/e/1FAIpQLSez6jW-xj5Q_jTzOTkQjj85WX1kRi3qML4RtS8XjfafrtuO9w/viewform" target="_blank" rel="noopener noreferrer">
				Quiero ser patrocinador
				<svg class="icon-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M5 12h14" />
					<path d="M13 6l6 6-6 6" />
				</svg>
			</a>
		</div>
	</div>
</section>

<style>
	.sponsors {
		position: relative;
		overflow: hidden;
		padding-block: var(--section-padding-block);
		background: linear-gradient(180deg, var(--color-ink-soft) 0%, var(--color-violet-deep) 100%);
	}

	.glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 50% 45% at 88% 32%, rgba(109, 74, 173, 0.28), transparent 68%);
		mix-blend-mode: screen;
		pointer-events: none;
	}

	.container {
		position: relative;
	}

	.lead {
		color: var(--color-text-inverse-muted);
		margin-top: 0.5rem;
		font-size: 1.05rem;
		max-width: 52ch;
	}

	h2 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.tier-group {
		margin-top: 2.75rem;
	}

	.tier-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-inverse-muted);
		margin-bottom: 1.25rem;
	}

	.tier-label::before {
		content: '';
		width: 22px;
		height: 3px;
		border-radius: 2px;
		background: var(--tier-color);
	}

	.tier-label-diamond {
		--tier-color: var(--color-orange);
	}

	.tier-label-gold {
		--tier-color: var(--color-violet);
	}

	.tier-label-silver {
		--tier-color: rgba(255, 255, 255, 0.3);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}

	.become-sponsor {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: flex-start;
		margin-top: 3.5rem;
		padding: 1.75rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.04);
	}

	.become-kicker {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--color-text-inverse);
	}

	.become-text {
		color: var(--color-text-inverse-muted);
		margin-top: 0.4rem;
		font-size: 0.95rem;
		max-width: 48ch;
	}

	.become-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		flex-shrink: 0;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 0.9rem;
		text-decoration: none;
		color: var(--color-ink);
		background: var(--color-orange);
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		white-space: nowrap;
		transition: background-color 0.15s ease;
	}

	.become-cta:hover {
		background: var(--color-orange-dark);
	}

	.become-cta .icon-arrow {
		transition: transform 0.2s ease;
	}

	.become-cta:hover .icon-arrow {
		transform: translateX(3px);
	}

	@media (min-width: 640px) {
		.become-sponsor {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
