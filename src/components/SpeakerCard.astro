---
interface Speaker {
	id: string;
	name: string;
	role?: string;
	topic?: string;
	photo?: string;
}

interface Props {
	speaker: Speaker;
}

const { speaker } = Astro.props;
const isPlaceholder = !speaker.photo;
---

<article class="card">
	<div class="media">
		{
			isPlaceholder ? (
				<div class="placeholder">
					<svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<circle cx="12" cy="8" r="4" />
						<path d="M4 20c0-4 3.6-6 8-6s8 2 8 6" />
					</svg>
				</div>
			) : (
				<img src={speaker.photo} alt={speaker.name} loading="lazy" />
			)
		}
	</div>
	<div class="info">
		<p class:list={['name', { muted: isPlaceholder }]}>{speaker.name}</p>
		{speaker.role && <p class="role">{speaker.role}</p>}
		{speaker.topic && <p class="topic">{speaker.topic}</p>}
	</div>
</article>

<style>
	.card {
		background: var(--color-ink);
		border-radius: 8px;
		overflow: hidden;
		border-top: 3px solid var(--color-orange);
	}

	.card:nth-child(3n + 2) {
		border-top-color: var(--color-violet);
	}

	.card:nth-child(3n + 3) {
		border-top-color: var(--color-magenta);
	}

	.media {
		position: relative;
		aspect-ratio: 1 / 1;
		background: var(--color-ink-soft);
	}

	.media img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.25);
	}

	.info {
		padding: 0.85rem 0.9rem 1rem;
	}

	.name {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text-inverse);
	}

	.name.muted {
		color: var(--color-text-inverse-muted);
		font-weight: 600;
	}

	.role {
		margin: 0.2rem 0 0;
		font-size: 0.78rem;
		color: var(--color-orange);
		font-weight: 600;
	}

	.topic {
		margin: 0.2rem 0 0;
		font-size: 0.78rem;
		color: var(--color-text-inverse-muted);
	}
</style>
